---
import ProductPage from '../../components/ProductPage.astro';
import VirtualLocationProductPage from '../../components/VirtualLocationProductPage.astro';
import { getProducts } from '../../data/products';

export function getStaticPaths() {
  return getProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

{
  product.slug === 'virtual-location' ? (
    <VirtualLocationProductPage locale="en" product={product} />
  ) : (
    <ProductPage locale="en" product={product} />
  )
}
