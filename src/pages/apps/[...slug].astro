---
import AppPage from '../../components/AppPage.astro';
import { getAppPageProps } from '../../lib/content';
import { defaultLocale } from '../../i18n';

export async function getStaticPaths() {
  // Default-locale articles: support stays at /apps/<slug>/; other kinds add a suffix.
  const pages = await getAppPageProps(defaultLocale);
  return pages.map((page) => ({
    params: { slug: page.kind === 'support' ? page.appSlug : `${page.appSlug}/${page.kind}` },
    props: page,
  }));
}

const props = Astro.props;
---

<AppPage {...props} />
