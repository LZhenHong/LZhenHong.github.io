---
import ProductPage from '../../../components/ProductPage.astro';
import VirtualLocationProductPage from '../../../components/VirtualLocationProductPage.astro';
import { getProducts } from '../../../data/products';
import { defaultLocale, locales, type Locale } from '../../../i18n';

export function getStaticPaths() {
  const products = getProducts();
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((locale) =>
      products.map((product) => ({
        params: { locale, slug: product.slug },
        props: { locale: locale as Locale, product },
      })),
    );
}

const { locale, product } = Astro.props;
---

{
  product.slug === 'virtual-location' ? (
    <VirtualLocationProductPage locale={locale} product={product} />
  ) : (
    <ProductPage locale={locale} product={product} />
  )
}
