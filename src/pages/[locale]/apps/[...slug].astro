---
import AppPage from '../../../components/AppPage.astro';
import { getAppPageProps } from '../../../lib/content';
import { locales, defaultLocale, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  // Localized app pages: /<locale>/apps/<slug>/, /<locale>/apps/<slug>/privacy/
  const paths = [];
  for (const locale of locales.filter((l) => l !== defaultLocale)) {
    for (const page of await getAppPageProps(locale as Locale)) {
      paths.push({
        params: {
          locale,
          slug: page.kind === 'privacy' ? `${page.appSlug}/privacy` : page.appSlug,
        },
        props: page,
      });
    }
  }
  return paths;
}

const props = Astro.props;
---

<AppPage {...props} />
