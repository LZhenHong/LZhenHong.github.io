---
import AppPage from '../../../components/AppPage.astro';
import { getAppPageProps } from '../../../lib/content';
import { locales, defaultLocale, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  // Localized articles: support stays at /<locale>/apps/<slug>/; other kinds add a suffix.
  const paths = [];
  for (const locale of locales.filter((l) => l !== defaultLocale)) {
    for (const page of await getAppPageProps(locale as Locale)) {
      paths.push({
        params: {
          locale,
          slug: page.kind === 'support' ? page.appSlug : `${page.appSlug}/${page.kind}`,
        },
        props: page,
      });
    }
  }
  return paths;
}

const props = Astro.props;
---

<AppPage {...props} />
