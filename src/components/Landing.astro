---
import Base from '../layouts/Base.astro';
import { ui, pageUrls, productPageUrls, type Locale } from '../i18n';
import type { Product } from '../data/products';

interface Props {
  locale: Locale;
  products: Product[];
}

const { locale, products } = Astro.props;
const t = ui[locale];
---

<Base
  title={t.siteTitle}
  description={t.metaDescription}
  locale={locale}
  alternates={pageUrls()}
  home
>
  <div class="site-width">
    <header class="home-hero">
      <h1>{t.heroTitle}</h1>
      <p class="muted">{t.heroBody}</p>
    </header>

    <section id="apps" aria-labelledby="apps-heading">
      <h2 id="apps-heading" class="visually-hidden">{t.apps}</h2>
      {
        products.length > 0 ? (
          <ul class="product-grid">
            {
              products.map((product) => (
                <li>
                  <a class="product-card" href={productPageUrls(product.slug)[locale]}>
                    <img
                      class="product-card__icon"
                      src={product.icon.src}
                      width={product.icon.width}
                      height={product.icon.height}
                      alt=""
                      decoding="async"
                    />
                    <span class="product-card__text">
                      <span class="product-card__name">{product.name}</span>
                      <span class="product-card__description">{product.cardDescription[locale]}</span>
                      <span class="product-card__platform muted">{product.platform}</span>
                    </span>
                    <svg
                      class="product-card__chevron"
                      width="20"
                      height="20"
                      viewBox="0 0 20 20"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="m7 4 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        ) : (
          <p class="empty-catalog muted">{t.emptyCatalog}</p>
        )
      }
    </section>
  </div>
</Base>
