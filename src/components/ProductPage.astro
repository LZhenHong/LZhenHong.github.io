---
import Base from '../layouts/Base.astro';
import StoreHopProductPage from './StoreHopProductPage.astro';
import { localePrefix, pageUrls, productPageUrls, ui, type Locale } from '../i18n';
import { productJsonLd } from '../lib/structuredData';
import type { Product } from '../data/products';

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const t = ui[locale];
const supportHref = product.supportUrls?.[locale] ?? pageUrls(product.slug)[locale];
const privacyHref = product.privacyUrls?.[locale] ?? pageUrls(product.slug, 'privacy')[locale];
const termsHref = product.termsUrls?.[locale];
const refundHref = product.refundUrls?.[locale];
---

{product.slug === 'storehop' ? (
  <StoreHopProductPage locale={locale} product={product} />
) : (
<Base
  title={`${product.name} — Eden`}
  description={product.tagline[locale]}
  locale={locale}
  alternates={productPageUrls(product.slug)}
  jsonLd={productJsonLd(product, locale, productPageUrls(product.slug)[locale])}
>
  <div class="site-width product-page">
    <a class="back-link" href={`${localePrefix(locale)}/#apps`}>{t.allApps}</a>

    <section
      class={`product-hero product-hero--${product.slug}`}
      style={`--screenshot-ratio: ${product.screenshot.width} / ${product.screenshot.height}`}
      aria-labelledby="product-title"
    >
      <div class="product-hero__text">
        <img
          class="product-hero__icon"
          src={product.icon.src}
          width={product.icon.width}
          height={product.icon.height}
          alt=""
          fetchpriority="high"
          decoding="async"
        />
        <h1 id="product-title">{product.name}</h1>
        <p class="product-tagline">{product.tagline[locale]}</p>
        <p class="product-platform">{product.platform}</p>
        <div class="product-actions">
          <a class="product-action primary-action" href={product.primaryAction.href}>
            {product.primaryAction.label[locale]}
          </a>
          {
            product.secondaryAction && (
              <a class="product-action secondary-action" href={product.secondaryAction.href}>
                {product.secondaryAction.label[locale]}
              </a>
            )
          }
          <a class="product-action secondary-action" href={supportHref}>{t.support}</a>
        </div>
      </div>

      <div class="product-visual">
        <div class="product-screen-shadow" aria-hidden="true"></div>
        <div class="product-screen">
          <img
            src={product.screenshot.src}
            width={product.screenshot.width}
            height={product.screenshot.height}
            alt={product.screenshot.alt[locale]}
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="product-features" aria-labelledby="features-heading">
      <h2 id="features-heading">{t.features}</h2>
      <ul class="features-grid">
        {
          product.features.map((feature, index) => (
            <li class="feature">
              <span class="feature-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{feature.title[locale]}</h3>
              <p>{feature.description[locale]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="product-utility-row">
      <a href={supportHref}>{t.support}</a>
      <a href={privacyHref}>{t.privacy}</a>
      {termsHref && <a href={termsHref}>{t.terms}</a>}
      {refundHref && <a href={refundHref}>{t.refund}</a>}
    </div>
  </div>
</Base>
)}
