---
import '../styles/main.css';
import { htmlLang, locales, localeNames, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  alternates: Record<Locale, string>;
}

const { title, description = '', locale, alternates } = Astro.props;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="container">
      <nav class="lang-switch" aria-label="Language">
        {
          locales.map((l, i) => (
            <Fragment>
              {i > 0 && <span class="sep">·</span>}
              {l === locale ? (
                <span class="current">{localeNames[l]}</span>
              ) : (
                <a href={alternates[l]} hreflang={htmlLang[l]}>
                  {localeNames[l]}
                </a>
              )}
            </Fragment>
          ))
        }
      </nav>
      <slot />
    </main>
  </body>
</html>
